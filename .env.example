# STILLFORM environment. Copy to .env.local and fill in. Never commit .env.local.
#
# Leave both empty to run the store on its built-in demo collection (no
# backend, checkout off). Both values are public by design: the browser only
# ever gets the anon / publishable key, and the database's security rules
# decide what it may do. Never put a service-role or secret key in this file.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API → anon public key (or the newer publishable key)
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (free bot check on checkout). Public by design.
# Its secret key goes to Supabase, never here:
#   npx supabase secrets set TURNSTILE_SECRET_KEY=…
VITE_TURNSTILE_SITE_KEY=

# Optional. false leaves the Studio dashboard out of the build (for a public demo).
# VITE_STUDIO_ENABLED=true
