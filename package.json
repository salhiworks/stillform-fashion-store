{
  "name": "stillform-store",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "setup": "node scripts/setup.mjs",
    "admin:grant": "node scripts/grant-admin.mjs",
    "verify:remote": "node tests/remote/verify.mjs",
    "preflight": "node scripts/preflight.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:build": "node scripts/build-seed.mjs",
    "test:permissions": "node tests/db/permissions.mjs",
    "test:remote": "playwright test --config playwright.remote.config.ts",
    "remote:users": "node tests/remote/create-test-users.mjs",
    "remote:cleanup": "node tests/remote/cleanup-test-data.mjs",
    "check:public": "node scripts/check-public.mjs",
    "test:showroom": "playwright test --config playwright.showroom.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "supabase": "2.122.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
